# PARALLAX reads these from the environment (export them in your shell).
# This file is not loaded automatically. Nothing here is required for a local demo.

# Optional: full URL of a trusted provider's chat/completions endpoint.
# Used to phrase answers and a one-sentence root-cause hypothesis; never to decide.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# Demo accounts sara, an and kim share this password. If empty, a random one is
# generated on first start and written to data/demo-login.txt (git-ignored).
PARALLAX_DEMO_PASSWORD=

# The account 'admin' logs in with an empty password, only from this machine.
# Set to 0 to switch that off, or set PARALLAX_ADMIN_PASSWORD to require a password.
PARALLAX_DEMO_ADMIN=1
PARALLAX_ADMIN_PASSWORD=

# For a deployment behind HTTPS (e.g. Cloud Run)
PARALLAX_ALLOWED_HOSTS=
PARALLAX_SECURE_COOKIES=0
PARALLAX_DEMO_CONTROLS=1
