# Trackrecord reads these from the environment (export them in your shell).
# Nothing here is required: without them the app runs fully offline.

# Optional fixed demo password. If empty, a random one is generated on first
# start and written to data/demo-login.txt (git-ignored).
TRACKRECORD_DEMO_PASSWORD=

# Optional: OpenAI-compatible chat/completions endpoint used ONLY to phrase a
# one-sentence root-cause hypothesis. Rules and scores never depend on it.
# Example (Gemini): https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
